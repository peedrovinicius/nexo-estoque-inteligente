# Backend / Spring Boot
# Use os dados do serviço MySQL da Aiven (host, porta, banco e usuário).
# A conexão em produção deve exigir TLS.
DB_URL=jdbc:mysql://HOST_MYSQL:PORTA/BANCO?sslMode=REQUIRED&serverTimezone=UTC
DB_USER=USUARIO_MYSQL
DB_PASSWORD=

# Segurança
NEXO_CORS_ALLOWED_ORIGINS=https://nexo-estoque-web.onrender.com,http://localhost:5173
NEXO_ADMIN_USER=admin
NEXO_ADMIN_PASSWORD=
NEXO_OPERATOR_USER=operador
NEXO_OPERATOR_PASSWORD=
NEXO_DEMO_USER=demo
NEXO_DEMO_PASSWORD=

# Banco e dados de demonstração
NEXO_DB_BOOTSTRAP=true
NEXO_DEMO_SEED=false

# IA opcional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Frontend / Vite
VITE_API_URL=https://nexo-estoque-api.onrender.com
